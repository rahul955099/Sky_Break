# ─────────────────────────────────────────────────────────────
# Skybreak Infra — environment configuration (copy to .env)
# Never commit real values. .env is git-ignored.
# ─────────────────────────────────────────────────────────────

# Runtime
# NODE_ENV defaults to "development". Set NODE_ENV=production on production servers.
# (Avoid NODE_ENV=development here: Vite would then produce a development React build.)
# NODE_ENV=production
SERVER_PORT=4000
# Hosting platforms inject PORT, which takes precedence over SERVER_PORT. HOST defaults to 0.0.0.0.
# PORT=
# HOST=0.0.0.0

# PostgreSQL (docker compose maps the dev DB to host port 5434)
DATABASE_URL=postgresql://skybreak:skybreak_dev_password@localhost:5434/skybreak?schema=public
# Managed providers usually need TLS: append &sslmode=require (Neon, Supabase, Render external URL).
# Max connections held by one server process (keep within your database plan's limit).
DB_POOL_MAX=10

# Long random secret (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL_HOURS=8

# Public URLs
# CLIENT_URL: comma-separated CORS allowlist of front-end origins
CLIENT_URL=http://localhost:5173
# PUBLIC_SITE_URL: canonical production domain used for sitemap, canonical & OG URLs
PUBLIC_SITE_URL=http://localhost:5173

# Reverse proxies in front of the app: "false", "true", or a hop count.
# Netlify proxy → Render: 2. Render (or one load balancer) only: 1.
TRUST_PROXY=false
# Session cookie SameSite: strict (same-origin API / Netlify proxy) | lax | none (cross-site API, HTTPS only)
COOKIE_SAMESITE=strict
# Serve the built React app (client/dist) from Express in production
SERVE_CLIENT=false

# First administrator (used by `npm run admin:create`)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Site Administrator
# Optional: supply ADMIN_PASSWORD only for non-interactive setup, then remove it.
# ADMIN_PASSWORD=

# Email notifications for new enquiries (optional — enquiries are always saved to the DB)
# EMAIL_PROVIDER=smtp enables delivery; leave as "none" to disable.
EMAIL_PROVIDER=none
SMTP_HOST=
# 587 is the usual local/provider default. Render's FREE plan blocks outbound 25/465/587, so
# production on Render uses Brevo on port 2525 (already set in render.yaml).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ENQUIRY_NOTIFY_TO=

# Reject enquiry emails whose domain cannot receive mail (DNS MX check; fails open on DNS errors).
EMAIL_DOMAIN_CHECK=true
# NOTE: customers without an Indian mobile number must verify their email with a 6-digit code.
# In production this requires EMAIL_PROVIDER=smtp; without it, the form asks for a mobile number.

# Image uploads (local disk storage). For cloud storage see README → "Image storage".
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Seed: set to false in production to load services/settings without illustrative sample projects
# SEED_SAMPLE_PROJECTS=false

# ─── Front-end build (Netlify) — public values only, never secrets ───
VITE_PUBLIC_SITE_URL=http://localhost:5173
# Netlify only: backend origin that /api/* is proxied to (recommended), e.g. https://skybreak-api.onrender.com
# API_PROXY_ORIGIN=
# Alternative to the proxy: full cross-origin API base (needs COOKIE_SAMESITE=none on the backend)
# VITE_API_URL=
