# ─────────────────────────────────────────────────────────────
# Skybreak Infra — environment configuration (copy to .env)
# Never commit real values. .env is git-ignored.
# ─────────────────────────────────────────────────────────────

# Runtime
# NODE_ENV defaults to "development". Set NODE_ENV=production on production servers.
# (Avoid NODE_ENV=development here: Vite would then produce a development React build.)
# NODE_ENV=production
SERVER_PORT=4000

# PostgreSQL (docker compose maps the dev DB to host port 5434)
DATABASE_URL=postgresql://skybreak:skybreak_dev_password@localhost:5434/skybreak?schema=public

# Long random secret (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL_HOURS=8

# Public URLs
# CLIENT_URL: comma-separated CORS allowlist of front-end origins
CLIENT_URL=http://localhost:5173
# PUBLIC_SITE_URL: canonical production domain used for sitemap, canonical & OG URLs
PUBLIC_SITE_URL=http://localhost:5173

# Set to "true" when running behind a reverse proxy / load balancer (for correct client IPs)
TRUST_PROXY=false
# Serve the built React app (client/dist) from Express in production
SERVE_CLIENT=false

# First administrator (used by `npm run admin:create`)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Site Administrator
# Optional: supply ADMIN_PASSWORD only for non-interactive setup, then remove it.
# ADMIN_PASSWORD=

# Email notifications for new enquiries (optional — enquiries are always saved to the DB)
# EMAIL_PROVIDER=smtp enables delivery; leave as "none" to disable.
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
ENQUIRY_NOTIFY_TO=

# Image uploads (local disk storage). For cloud storage see README → "Image storage".
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Front-end (Vite) — public values only, never secrets
VITE_PUBLIC_SITE_URL=http://localhost:5173
